# ---------------------------------------------------------------
# 复制为 .env 后按需修改：cp .env.example .env
# ---------------------------------------------------------------

# 唯一对外端口：Web UI 与 /v1 API 都走它（面板反代 /v1/* 给内网 API）
PANEL_PORT=3008

# 镜像名（docker compose build 后的 tag）
WB2API_IMAGE=workbuddy2api:latest

# 时区
TZ=Asia/Shanghai

# 对外 API 地址。面板自身就是 API 入口，默认同源，一般不用填。
# 只有走独立域名 / 反向代理时才设置，例如：
# PUBLIC_API_BASE=https://api.example.com
PUBLIC_API_BASE=

# ---------------------------------------------------------------
# 可选调优（不填用代码里的默认值）
# ---------------------------------------------------------------

# 账号被 429/超额后跳过多久（秒）
CODEBUDDY_RATE_COOLDOWN=30

# 会话粘性 TTL（秒）：同一会话保持在同一账号上以命中上游 prompt cache
CODEBUDDY_SESSION_TTL=1800

# 全局思考强度：留空 = 用请求里的值。可选 low / medium / high / max
CODEBUDDY_REASONING_EFFORT=
